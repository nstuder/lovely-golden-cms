{
    "name": "lovely-golden.de",
    "description": "Official Website of Moments of Love Golden Retriever",
    "version": "2.0.0",
    "license": "MIT",
    "type": "module",
    "private": true,
    "engines": {
        "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
    },
    "scripts": {
        "dev": "npm run sass && concurrently -k -n next,sass \"next dev\" \"npm run sass:dev\"",
        "build": "npm run sass && next build",
        "start": "next start",
        "sass": "sass src/styles/main.scss public/assets/styles/main.css --style compressed --no-source-map",
        "sass:dev": "sass --watch src/styles/main.scss public/assets/styles/main.css --style compressed",
        "payload": "payload",
        "generate:types": "payload generate:types",
        "generate:importmap": "payload generate:importmap",
        "generate:graphQLSchema": "payload generate:graphQLSchema",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
        "format": "prettier . --write && npm run lint:fix"
    },
    "dependencies": {
        "@payloadcms/db-mongodb": "3.94.1",
        "@payloadcms/next": "3.94.1",
        "@payloadcms/richtext-slate": "3.94.1",
        "@payloadcms/translations": "3.94.1",
        "@payloadcms/ui": "3.94.1",
        "@popperjs/core": "2.11.7",
        "bootstrap": "5.2.3",
        "graphql": "16.15.0",
        "next": "16.4.6",
        "payload": "3.94.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "sharp": "0.35.5"
    },
    "devDependencies": {
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript-eslint/eslint-plugin": "8.73.0",
        "@typescript-eslint/parser": "8.73.0",
        "@vitejs/plugin-react": "6.1.2",
        "concurrently": "9.2.5",
        "eslint": "8.57.1",
        "jsdom": "30.1.3",
        "prettier": "3.0.3",
        "sass": "1.59.3",
        "typescript": "5.9.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
