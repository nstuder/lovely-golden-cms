        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.14.0",
        "jsdom": "31.0.0",
        "prettier": "3.9.10",
        "sass": "1.108.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.2",
        "vite": "8.3.7",
        "vitest": "5.1.0"
    },
    "overrides": {
        "@typescript-eslint/typescript-estree": {
