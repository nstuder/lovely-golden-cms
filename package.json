        "@payloadcms/translations": "3.94.1",
        "@payloadcms/ui": "3.94.1",
        "@popperjs/core": "2.11.8",
        "bootstrap": "5.3.8",
        "graphql": "16.15.0",
        "next": "16.4.6",
        "payload": "3.94.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "sharp": "0.35.5"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
